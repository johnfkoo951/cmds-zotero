{
  "name": "cmds-zotero",
  "version": "0.6.2",
  "description": "Connect citations, annotations, source links and literature notes to your vault. By CMDSPACE.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production && node esbuild.config.mjs core",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build:core": "node esbuild.config.mjs core"
  },
  "keywords": [
    "obsidian",
    "cmdspace",
    "zotero",
    "betterbibtex",
    "citations",
    "hookmark"
  ],
  "author": "Yohan Koo (CMDSPACE)",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "22.19.0",
    "esbuild": "0.25.10",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.14.4",
    "tslib": "2.8.1",
    "tsx": "4.23.13",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.1"
  }
}
